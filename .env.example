# ──────────────────────────────────────────────────────────────
# Notice2Action — environment variables
# Copy this file to .env for local development.
# In Vercel, add these under Project → Settings → Environment Variables.
# NEVER commit your real .env file.
# ──────────────────────────────────────────────────────────────

# ---- Backend / server-side only (never exposed to the browser) ----

# MongoDB Atlas connection string
# Get this from Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/notice2action?retryWrites=true&w=majority

# Anthropic API key — server-side only, never sent to the frontend
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude model to use for analysis. Check current model names/aliases at
# https://docs.claude.com/en/docs/about-claude/models before deploying,
# since names change over time.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional authentication (JWT). Only needed if you enable the auth module.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API.
# Include your local dev URL and your deployed Vercel frontend URL.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional: Cloudinary, used to keep a copy of the original uploaded PDF
# so it can be viewed again later (backend/services/storageService.js).
# Entirely optional — PDF analysis works without these set; only the
# "View original PDF" link is skipped if they're missing.
# Get these from https://console.cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Node environment
NODE_ENV=development

# ---- Frontend (safe to expose — anything the browser needs) ----

# Base URL the frontend uses to reach the backend API.
# Locally this points at the Express dev server; in production, since the
# frontend and API are deployed together on Vercel, this can be a relative
# path ("/api") so no separate domain configuration is needed.
VITE_API_URL=http://localhost:3001/api
